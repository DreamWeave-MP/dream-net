#!/usr/bin/env python3
# SPDX-License-Identifier: MIT OR Apache-2.0
"""Regenerate native/csrc/dn_native_prefix.h.

The header is force-included into every C translation unit of the native archive and renames
each external symbol netcode, reliable and the bundled libsodium define to dn_native_<name>, so a
host that links its own netcode, reliable or libsodium cannot collide with ours (shared decision
4). It is generated, checked in, and reproducible:

    native/tools/gen-prefix-header            # rewrite the header
    native/tools/gen-prefix-header --check    # exit 1 if the checked-in header is stale

The symbol list is the union of
  1. every external symbol llvm-nm reports defined in the three vendored translation units,
     compiled here for the host without the prefix header, and
  2. EXTRA below: names that are external only on platforms this host cannot compile for,
     found by reading the sources (each with the line that defines it).
tests/native_build_symbols.rs then checks, on every platform the tests run on, that the built archive
defines no external symbol without the prefix, so a missed platform-only name fails CI there.

Needs clang and llvm-nm (CC / NM override them). Python 3.8+, standard library only.
"""

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
NATIVE = os.path.dirname(HERE)
VENDOR = os.path.join(NATIVE, "vendor")
HEADER = os.path.join(NATIVE, "csrc", "dn_native_prefix.h")
PREFIX = "dn_native_"

SOURCES = [
    ("netcode/netcode.c", ["-I", os.path.join(VENDOR, "netcode", "sodium")]),
    ("netcode/sodium/sodium.c", []),
    ("reliable/reliable.c", []),
]

# External only where this Linux host cannot build: keep each with its reason.
EXTRA = {
    # sodium.c, sodium_core.c section: `int _sodium_crit_init(void)` under `#ifdef _WIN32`
    # (upstream libsodium made it static in 1.0.19; the bundled copy predates that).
    "_sodium_crit_init",
    # sodium.c, utils.c section: weak definitions under HAVE_WEAK_SYMBOLS, which this build never
    # defines; listed so that defining it later cannot leak them unprefixed.
    "_sodium_dummy_symbol_to_prevent_compare_lto",
    "_sodium_dummy_symbol_to_prevent_memcmp_lto",
    "_sodium_dummy_symbol_to_prevent_memzero_lto",
}


def tool(env, default):
    path = os.environ.get(env) or shutil.which(default)
    if not path:
        sys.exit(f"gen-prefix-header: {default} not found; set {env}")
    return path


def defined_symbols(cc, nm):
    names = set()
    with tempfile.TemporaryDirectory(prefix="gen-prefix-") as scratch:
        for index, (source, extra) in enumerate(SOURCES):
            obj = os.path.join(scratch, f"{index}.o")
            subprocess.run(
                [cc, "-std=gnu99", "-O1", "-c", "-o", obj, *extra, os.path.join(VENDOR, source)],
                check=True,
            )
            out = subprocess.run(
                [nm, "--defined-only", "--extern-only", "--format=just-symbols", obj],
                check=True,
                capture_output=True,
                text=True,
            ).stdout
            names.update(line.strip() for line in out.splitlines() if line.strip())
    if sys.platform == "darwin":
        names = {n[1:] if n.startswith("_") else n for n in names}
    return names


def render(names):
    width = max(len(n) for n in names)
    lines = [
        "/*",
        "    Generated by native/tools/gen-prefix-header. Do not edit.",
        "    SPDX-License-Identifier: MIT OR Apache-2.0",
        "",
        "    Force-included into every C translation unit of the native archive (build.rs), so every",
        "    external symbol of netcode, reliable and the bundled libsodium is defined and referenced",
        f"    as {PREFIX}<name>. Rust declarations link against the prefixed names, for example",
        f'    #[link_name = "{PREFIX}netcode_init"].',
        "*/",
        "",
        "#ifndef DN_NATIVE_PREFIX_H",
        "#define DN_NATIVE_PREFIX_H",
        "",
    ]
    for name in sorted(names):
        lines.append(f"#define {name.ljust(width)} {PREFIX}{name}")
    lines += ["", "#endif /* DN_NATIVE_PREFIX_H */", ""]
    return "\n".join(lines)


def main():
    check = "--check" in sys.argv[1:]
    names = defined_symbols(tool("CC", "clang"), tool("NM", "llvm-nm")) | EXTRA
    unprefixable = sorted(n for n in names if n.startswith(PREFIX))
    if unprefixable:
        sys.exit(f"gen-prefix-header: vendored code already defines {PREFIX}* names: {unprefixable}")
    text = render(names)
    if check:
        with open(HEADER, encoding="utf-8") as handle:
            if handle.read() != text:
                print("gen-prefix-header: csrc/dn_native_prefix.h is stale; run native/tools/gen-prefix-header", file=sys.stderr)
                return 1
        print(f"gen-prefix-header: csrc/dn_native_prefix.h is current ({len(names)} symbols)")
        return 0
    with open(HEADER, "w", encoding="utf-8", newline="\n") as handle:
        handle.write(text)
    print(f"gen-prefix-header: wrote csrc/dn_native_prefix.h ({len(names)} symbols)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
